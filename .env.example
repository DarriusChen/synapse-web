# Copy to .env.local (never commit secrets).
#
# After creating the project:
# 1. Project Settings → API → Project URL → SUPABASE_URL
# 2. Project Settings → API → service_role (secret) → SUPABASE_SERVICE_ROLE_KEY
# 3. SQL Editor: run supabase/migrations/001_topics.sql then supabase/seed.sql
# 4. Restart next dev

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared password for /admin (required in production).
ADMIN_PASSWORD=change-me
